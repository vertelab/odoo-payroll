# .pfiles-allow — filer som inte är p-filer (än).
# En sökväg per rad, relativ till repo-roten. '#' inleder kommentar.
# Genererad: pfiles-check --version 18.0 --print-allow .
#
# Odoo-modulerna: allt versionsberoende är p-fil. Det som står här är
# antingen genererat (index.html) eller medvetet 18.0-only.

# security/ir.access.csv är 20.0-filen. Den laddas aldrig i 18/19 (manifestet
# väljer ir.model.access.csv där) — se odoo-pfiles fälla 12c.
hr_payroll_benefits/security/ir.access.csv
hr_payroll_employeefund/security/ir.access.csv
payroll_driving_record/security/ir.access.csv

# Kommenterad ur manifestet sedan tidigare (18.0-only vy för utlägg).
hr_payroll_employeefund/views/hr_expense_view_form.xml

# Genererad av Odoo-appstore-verktyget, inte en källa.
hr_expense_journal_selection/static/description/index.html
hr_payroll_benefits/static/description/index.html
hr_payroll_employeefund/static/description/index.html
hr_weekly_working_hours/static/description/index.html
payroll_driving_record/static/description/index.html

# Flutter-appen (native_app) är inte Odoo-kod och versionshanteras inte med
# p-filer. Den ligger kvar som den är.
payroll_driving_record/native_app/android/app/src/debug/AndroidManifest.xml
payroll_driving_record/native_app/android/app/src/main/AndroidManifest.xml
