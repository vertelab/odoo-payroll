<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- #if VERSION >= "20.0" -->
    <!-- 20.0 merged ir.rule into ir.access: the same domain is a restriction
         on the access record. One row per rule - same model, same group,
         same domain. -->
    <record id="ir_rule_driving_record_manager" model="ir.access">
        <field name="name">ir_rule_driving_record_manager</field>
        <field name="model_id" ref="model_driving_record"/>
        <field name="operation">crud</field>
        <field name="group_id" ref="hr_expense.group_hr_expense_manager"/>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <record id="ir_rule_driving_record_approver" model="ir.access">
        <field name="name">ir_rule_driving_record_approver</field>
        <field name="model_id" ref="model_driving_record"/>
        <field name="operation">crud</field>
        <field name="group_id" ref="hr_expense.group_hr_expense_team_approver"/>
        <field name="domain">['|', '|', '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id),
            ('employee_id.expense_manager_id', '=', user.id)]</field>
    </record>

    <record id="ir_rule_driving_record_employee" model="ir.access">
        <field name="name">ir_rule_driving_record_employee</field>
        <field name="model_id" ref="model_driving_record"/>
        <field name="operation">crud</field>
        <field name="group_id" ref="base.group_user"/>
        <field name="domain">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="ir_rule_driving_record_line_manager" model="ir.access">
        <field name="name">ir_rule_driving_record_line_manager</field>
        <field name="model_id" ref="model_driving_record_line"/>
        <field name="operation">crud</field>
        <field name="group_id" ref="hr_expense.group_hr_expense_manager"/>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <record id="ir_rule_driving_record_line_approver" model="ir.access">
        <field name="name">ir_rule_driving_record_line_approver</field>
        <field name="model_id" ref="model_driving_record_line"/>
        <field name="operation">crud</field>
        <field name="group_id" ref="hr_expense.group_hr_expense_team_approver"/>
        <field name="domain">['|', '|', '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id),
            ('employee_id.expense_manager_id', '=', user.id)]</field>
    </record>

    <record id="ir_rule_driving_record_line_employee" model="ir.access">
        <field name="name">ir_rule_driving_record_line_employee</field>
        <field name="model_id" ref="model_driving_record_line"/>
        <field name="operation">crud</field>
        <field name="group_id" ref="base.group_user"/>
        <field name="domain">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <!-- #else -->


    <!-- Driving Record -->
    <!-- Manager -->
    <record id="ir_rule_driving_record_manager" model="ir.rule">
        <field name="name">Driving Record Manager</field>
        <field name="model_id" ref="model_driving_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_manager'))]"/>
    </record>

    <!-- Team Approver -->
    <record id="ir_rule_driving_record_approver" model="ir.rule">
        <field name="name">Driving Record Team Approver</field>
        <field name="model_id" ref="model_driving_record"/>
        <field name="domain_force">['|', '|', '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id),
            ('employee_id.expense_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_team_approver'))]"/>
    </record>

    <!-- Employee -->
    <record id="ir_rule_driving_record_employee" model="ir.rule">
        <field name="name">Driving Record Employee</field>
        <field name="model_id" ref="model_driving_record"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <!-- Driving Record Line-->
    <!-- Manager -->
    <record id="ir_rule_driving_record_line_manager" model="ir.rule">
        <field name="name">Driving Record Line Manager</field>
        <field name="model_id" ref="model_driving_record_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_manager'))]"/>
    </record>

    <!-- Team Approver -->
    <record id="ir_rule_driving_record_line_approver" model="ir.rule">
        <field name="name">Driving Record Line Team Approver</field>
        <field name="model_id" ref="model_driving_record_line"/>
        <field name="domain_force">['|', '|', '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id),
            ('employee_id.expense_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_team_approver'))]"/>
    </record>

    <!-- Employee -->
    <record id="ir_rule_driving_record_line_employee" model="ir.rule">
        <field name="name">Driving Record Line Employee</field>
        <field name="model_id" ref="model_driving_record_line"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- #endif -->

</odoo>
