<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- #if VERSION < "19.0" -->
    <!-- hr.version has no dedicated form view in 19.0/20.0 (versions are
         edited from the employee form with a version_id context), so there is
         no form view to inherit. The fields are still on the model there. -->
    <record model="ir.ui.view" id="hr_contract_view_form">
      <field name="name">hr.contract.view.form.weekly_work_hours</field>
      <field name="model">hr.contract</field>
      <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
      <field name="arch" type="xml">
          <field name="resource_calendar_id" position="after">
          
          <group>
            <field name="scheduled_working_hours"/>
            <field name="weekly_working_hours"/>
            <field name="wwh_days_full"/>
            <field name="wwh_days_intermittent"/>
            <field name="working_percent"/>
          </group>
          </field>

      </field>
    </record>
    <!-- #endif -->
  </data>
</odoo>
